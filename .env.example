OIDC_ISSUER_URI=http://localhost:8180/realms/agrosphere
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/agrosphere_estate
DB_USER=agrosphere_estate
DB_PASSWORD=REPLACE_LOCALLY
RABBITMQ_HOST=localhost
RABBITMQ_USER=agrosphere
RABBITMQ_PASSWORD=REPLACE_LOCALLY
OIDC_AUDIENCE=estate-service
RABBITMQ_PORT=5672
OUTBOX_PUBLICATION_ENABLED=false
EVENT_DATA_PROVENANCE=REAL
OTEL_METRICS_ENABLED=false

